{
  "name": "nomi-blog",
  "version": "3.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsx ./src/engine/prerender.ts",
    "preview": "npx serve dist/",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/engine.test.ts tests/markdown.test.ts tests/posts.test.ts tests/build.test.ts",
    "test:e2e": "pnpm build && tsx --test tests/e2e.test.ts"
  },
  "dependencies": {
